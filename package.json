{
  "name": "torrently",
  "version": "1.0.0",
  "description": "Cross-platform desktop torrent client with instant video streaming while downloading",
  "main": "src/main/index.js",
  "bin": {
    "torrently": "bin/torrently"
  },
  "scripts": {
    "start": "node scripts/run-sandbox.js",
    "start:raw": "electron .",
    "dev": "node scripts/run-sandbox.js",
    "cli": "node bin/torrently",
    "test": "node scripts/test-sandbox.js",
    "icon": "electron scripts/generate-icon.js",
    "dist": "electron-builder --mac dmg zip --arm64",
    "dist:dmg": "electron-builder --mac dmg --arm64",
    "dist:deb": "electron-builder --linux deb --x64 -c.npmRebuild=false",
    "dist:dir": "electron-builder --dir --arm64"
  },
  "keywords": [
    "torrent",
    "bittorrent",
    "webtorrent",
    "video-streaming",
    "cross-platform",
    "electron"
  ],
  "author": "vikeshvee <vikeshvee@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.torrently.app",
    "productName": "Torrently",
    "copyright": "Copyright © 2026 Torrently Team",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "src/**/*",
      "bin/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!tests",
      "!skills",
      "!scripts",
      "!Downloads"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Torrently ${version}",
      "icon": "build/icon.icns",
      "iconSize": 110,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "maintainer": "vikeshvee <vikeshvee@gmail.com>"
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "net"
    },
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent File",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent"
      }
    ],
    "protocols": [
      {
        "name": "Magnet URI Scheme",
        "schemes": [
          "magnet"
        ]
      }
    ]
  }
}
